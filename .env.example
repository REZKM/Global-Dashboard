# Copy this to .env for local testing (Railway: set these as project Variables instead).

# A long random string used to sign session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Comma-separated list of the only emails allowed to sign up / log in.
ALLOWED_EMAILS=you@example.com,colleague@example.com

# Provided automatically by Railway once you add a Postgres database to this
# project (New -> Database -> Add PostgreSQL). For local testing, point this
# at your own local Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/dashboard_auth

NODE_ENV=production
